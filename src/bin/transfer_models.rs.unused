use ::std::{
    fs::{create_dir_all, File},
    io::{self, Read, Write},
    path::{Path, PathBuf},
};
use brotli::CompressorWriter;
use lingua::{load_json, Language, LanguageModelFilesWriter};
use strum::IntoEnumIterator;

pub(crate) fn ngram_name_by_length(ngram_length: usize) -> &'static str {
    match ngram_length {
        1 => "unigram.encom.br",
        2 => "bigram.encom.br",
        3 => "trigram.encom.br",
        4 => "quadrigram.encom.br",
        5 => "fivegram.encom.br",
        _ => panic!("ngram length {ngram_length} is not in range 1..6"),
    }
}

fn main() {
    for language in Language::iter() {
        for ngram_length in 1..6 {
            let json = load_json(language, ngram_length);
            if let Ok(Some(json_model)) = json {
                let serialized = serde_encom::to_string(&json_model.ngrams).unwrap();

                let file_name = ngram_name_by_length(ngram_length);
                let file_path = PathBuf::from("./lang_models")
                    .join(&language.to_string())
                    .join(file_name);

                if let Some(parent) = file_path.parent() {
                    create_dir_all(parent).unwrap();
                }
                let file = File::create(file_path).unwrap();
                let mut compressed_file = CompressorWriter::new(file, 4096, 11, 22);
                compressed_file.write_all(serialized.as_bytes()).unwrap();
            }
        }
    }
}
